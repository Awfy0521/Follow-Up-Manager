   ============================================ */

.page {
  min-height: 100vh;
  background: var(--color-bg);
  display: flex;
  flex-direction: column;
}

/* ---- Header ---- */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  height: 88rpx;
  background: var(--color-primary);
  flex-shrink: 0;
}

.header-back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
}

.header-back:active {
  background: rgba(255, 255, 255, 0.22);
}

.back-arrow {
  font-size: 44rpx;
  color: #FFFFFF;
  font-weight: 300;
  line-height: 1;
}

.header-title {
  font-size: 34rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.header-placeholder {
  width: 64rpx;
}

/* ---- Form ---- */
.form {
  flex: 1;
  padding: 24rpx 28rpx;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  box-sizing: border-box;
  width: 100%;
}

.form-section-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 28rpx;
  margin-top: 8rpx;
}

.section-dot {
  width: 8rpx;
  height: 30rpx;
  background: var(--color-accent);
  border-radius: 4rpx;
}

.section-title {
  font-size: 30rpx;
  color: var(--color-text);
  font-weight: 600;
}

.form-group {
  margin-bottom: 24rpx;
  background: var(--color-card);
  border-radius: var(--radius-md);
  padding: 24rpx;
  border: 1rpx solid var(--color-border-light);
}

.label {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 14rpx;
  font-weight: 500;
}

.input-wrap,
.textarea-wrap {
  background: var(--color-bg);
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--color-border);
}

.input-wrap:focus-within,
.textarea-wrap:focus-within {
  border-color: var(--color-accent);
}

.input {
  width: 100%;
  height: 80rpx;
  background: transparent;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: var(--color-text);
  box-sizing: border-box;
}

.textarea {
  width: 100%;
  min-height: 160rpx;
  background: transparent;
  padding: 20rpx;
  font-size: 28rpx;
  color: var(--color-text);
  box-sizing: border-box;
  line-height: 1.6;
}

.picker {
  height: 80rpx;
  line-height: 80rpx;
  background: var(--color-bg);
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--color-border);
  padding: 0 20rpx;
  font-size: 28rpx;
  color: var(--color-text);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-value {
  font-size: 28rpx;
  color: var(--color-text);
}

.placeholder-state .picker-value {
  color: var(--color-text-muted);
}

.picker-arrow {
  font-size: 36rpx;
  color: var(--color-text-muted);
}

.placeholder {
  color: var(--color-text-muted);
  font-size: 28rpx;
}

/* ---- Buttons ---- */
.btn-group {
  padding: 20rpx 28rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 20rpx;
  background: var(--color-card);
  border-top: 1rpx solid var(--color-border-light);
  flex-shrink: 0;
  width: 100%;
  box-sizing: border-box;
}

.btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: var(--radius-lg);
  font-size: 30rpx;
  font-weight: 600;
  padding: 0;
  margin: 0;
}

.btn::after {
  border: none;
}

.btn:active {
  opacity: 0.85;
}

.btn-primary {
  background: var(--color-accent);
  color: #FFFFFF;
}

.btn-primary[disabled] {
  opacity: 0.45;
}

.btn-secondary {
  background: var(--color-card);
  color: var(--color-text);
  border: 2rpx solid var(--color-border);
}

.btn-secondary:active {
  background: var(--color-bg);
}

.btn-text {
  font-size: 30rpx;
}
