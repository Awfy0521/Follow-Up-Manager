/* ============================================
   followUpList.wxss
   ============================================ */

.page {
  height: 100vh;
  background: var(--color-bg);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  width: 100%;
  box-sizing: border-box;
}

/* ---- Header ---- */
.header-wrap {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: var(--color-primary);
  flex-shrink: 0;
  width: 100%;
  box-sizing: border-box;
}

.status-bar {
  background: var(--color-primary);
  width: 100%;
  box-sizing: border-box;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  height: 88rpx;
  background: var(--color-primary);
  width: 100%;
  box-sizing: border-box;
}

.header-left {
  width: 80rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-btn:active {
  background: rgba(255, 255, 255, 0.22);
}

.back-arrow {
  font-size: 44rpx;
  color: #FFFFFF;
  font-weight: 300;
  line-height: 1;
}

.header-center {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.header-title {
  font-size: 34rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.header-sub {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.45);
  margin-top: -2rpx;
}

.header-right {
  width: 80rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.header-icon-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
}

.header-icon-btn:active {
  background: rgba(255, 255, 255, 0.22);
}

.header-icon {
  font-size: 36rpx;
  color: #FFFFFF;
}

.header-accent {
  height: 4rpx;
  background: var(--color-accent);
}

/* ---- Content ---- */
.content {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  width: 100%;
  box-sizing: border-box;
}

/* ---- Search Bar ---- */
.search-bar {
  padding: 16rpx 28rpx;
  background: var(--color-card);
  flex-shrink: 0;
}

.search-wrap {
  display: flex;
  align-items: center;
  background: var(--color-bg);
  border-radius: 40rpx;
  padding: 0 24rpx;
  height: 72rpx;
  border: 1rpx solid var(--color-border);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: var(--color-text);
  height: 72rpx;
}

.search-placeholder {
  color: var(--color-text-muted);
  font-size: 26rpx;
}

.search-clear {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--color-border);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.clear-icon {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

/* ---- Tab Bar ---- */
.tab-bar {
  display: flex;
  background: var(--color-card);
  border-bottom: 1rpx solid var(--color-border-light);
  flex-shrink: 0;
  width: 100%;
  box-sizing: border-box;
  position: relative;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 26rpx 0;
  font-size: 28rpx;
  color: var(--color-text-muted);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.tab-item.active {
  color: var(--color-primary);
  font-weight: 600;
}

.tab-badge {
  background: var(--color-accent);
  border-radius: 20rpx;
  padding: 0 14rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.badge-text {
  font-size: 20rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.tab-indicator {
  position: absolute;
  bottom: 0;
  width: 50%;
  height: 6rpx;
  background: var(--color-accent);
  border-radius: 3rpx 3rpx 0 0;
  transition: left 0.3s cubic-bezier(0.25, 0.1, 0.25, 1);
}

/* ---- Record List ---- */
.record-list {
  flex: 1;
  padding: 24rpx 28rpx 32rpx;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  box-sizing: border-box;
  width: 100%;
  min-height: 0;
}

.record-card {
  background: var(--color-card);
  border-radius: var(--radius-lg);
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx var(--color-shadow);
  overflow: hidden;
  display: flex;
  border: 1rpx solid var(--color-border-light);
}

.card-accent-bar {
  width: 6rpx;
  flex-shrink: 0;
}

.card-inner {
  flex: 1;
  padding: 28rpx 24rpx 22rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 14rpx;
}

.card-actions {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.card-delete {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #FFF0F0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-delete:active {
  background: #FFD4D4;
}

.delete-icon {
  font-size: 28rpx;
}

.card-title-row {
  flex: 1;
}

.card-title {
  font-size: 30rpx;
  color: var(--color-text);
  font-weight: 600;
  line-height: 1.4;
}

.card-number {
  background: var(--color-bg);
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.number-text {
  font-size: 22rpx;
  color: var(--color-text-muted);
  font-weight: 500;
}

.card-body {
  margin-bottom: 16rpx;
}

.card-content {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  line-height: 1.65;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-footer {
  display: flex;
  justify-content: flex-end;
}

.card-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.meta-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.card-date {
  font-size: 24rpx;
  color: var(--color-text-muted);
}

/* ---- Empty State ---- */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon-wrap {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: var(--color-accent-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.empty-icon {
  font-size: 56rpx;
}

.empty-title {
  font-size: 30rpx;
  color: var(--color-text);
  font-weight: 600;
  margin-bottom: 10rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: var(--color-text-muted);
}

/* ---- Loading / No More ---- */
.loading-state {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
}

.loading-text {
  font-size: 26rpx;
  color: var(--color-text-muted);
}

.no-more {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
}

.no-more-text {
  font-size: 24rpx;
  color: var(--color-text-muted);
}

/* ---- Bottom Bar ---- */
.bottom-bar {
  flex-shrink: 0;
  background: var(--color-card);
  border-top: 1rpx solid var(--color-border-light);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 16rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  width: 100%;
  box-sizing: border-box;
}

.add-btn {
  width: 80rpx;
  height: 80rpx;
  background: var(--color-accent);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(74, 144, 217, 0.3);
}

.add-btn:active {
  transform: scale(0.92);
}

.add-icon {
  color: #FFFFFF;
  font-size: 48rpx;
  line-height: 1;
  font-weight: 300;
  margin-top: -2rpx;
}

.add-label {
  font-size: 20rpx;
  color: var(--color-text-muted);
  margin-top: 6rpx;
  margin-bottom: 4rpx;
}
