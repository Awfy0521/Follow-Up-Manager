<view class="page">
  <!-- Fixed Header -->
  <view class="header-wrap">
    <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>
    <view class="header">
      <view class="header-left" bindtap="goBack">
        <view class="back-btn">
          <text class="back-arrow">‹</text>
        </view>
      </view>
      <view class="header-center">
        <text class="header-title">跟进详情</text>
        <text class="header-sub">DevOpsGPT</text>
      </view>
      <view class="header-right">
        <view class="header-icon-btn" bindtap="onRefresh">
          <text class="header-icon">↻</text>
        </view>
      </view>
    </view>
    <view class="header-accent"></view>
  </view>

  <!-- Content Area -->
  <view class="content" style="padding-top: {{statusBarHeight + 46}}px;">
    <!-- Tab Bar -->
    <view class="tab-bar">
      <view class="tab-item {{activeTab === 'detail' ? 'active' : ''}}" bindtap="switchTab" data-tab="detail">
        <text class="tab-text">项目详情</text>
      </view>
      <view class="tab-item {{activeTab === 'records' ? 'active' : ''}}" bindtap="switchTab" data-tab="records">
        <text class="tab-text">跟进记录</text>
        <view class="tab-badge" wx:if="{{recordCount > 0}}">
          <text class="badge-text">{{recordCount}}</text>
        </view>
      </view>
      <view class="tab-indicator" style="left: {{activeTab === 'detail' ? '0' : '50'}}%;"></view>
    </view>

    <!-- Search Bar -->
    <view class="search-bar" wx:if="{{activeTab === 'records'}}">
      <view class="search-wrap">
        <text class="search-icon">🔍</text>
        <input class="search-input" placeholder="搜索跟进记录" placeholder-class="search-placeholder" value="{{keyword}}" bindinput="onSearchInput" bindconfirm="onSearch" />
        <view class="search-clear" wx:if="{{keyword}}" bindtap="onClearSearch">
          <text class="clear-icon">✕</text>
        </view>
      </view>
    </view>

    <!-- Record List -->
    <view class="record-list">
      <view class="record-card" wx:for="{{records}}" wx:key="id" style="animation-delay: {{index * 0.06}}s;">
        <view class="card-accent-bar" style="background: {{index % 3 === 0 ? '#4A90D9' : index % 3 === 1 ? '#34A77B' : '#E8913A'}};"></view>
        <view class="card-inner">
          <view class="card-header">
            <view class="card-title-row">
              <text class="card-title">{{item.title}}</text>
            </view>
            <view class="card-actions">
              <view class="card-delete" catchtap="onDeleteRecord" data-id="{{item.id}}">
                <text class="delete-icon">🗑</text>
              </view>
            </view>
          </view>
          <view class="card-body">
            <text class="card-content">{{item.content}}</text>
          </view>
          <view class="card-footer">
            <view class="card-meta">
              <text class="meta-dot" style="background: {{index % 3 === 0 ? '#4A90D9' : index % 3 === 1 ? '#34A77B' : '#E8913A'}};"></text>
              <text class="card-date">{{item.date}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- Loading -->
      <view class="loading-state" wx:if="{{loading && records.length > 0}}">
        <text class="loading-text">加载中...</text>
      </view>

      <!-- No More -->
      <view class="no-more" wx:if="{{!hasMore && records.length > 0}}">
        <text class="no-more-text">— 没有更多了 —</text>
      </view>

      <!-- Empty State -->
      <view class="empty-state" wx:if="{{!loading && records.length === 0}}">
        <view class="empty-icon-wrap">
          <text class="empty-icon">📝</text>
        </view>
        <text class="empty-title">暂无跟进记录</text>
        <text class="empty-hint">点击下方按钮添加第一条记录</text>
      </view>
    </view>
  </view>

  <!-- Bottom Action Bar -->
  <view class="bottom-bar">
    <view class="add-btn" bindtap="goToAdd">
      <text class="add-icon">+</text>
    </view>
    <text class="add-label">新建记录</text>
  </view>
</view>
